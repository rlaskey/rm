{
  "name": "rm-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build browser/*.tsx --outdir=dist --target=browser --minify --splitting --sourcemap=linked",
    "dev": "bun --watch main.ts",
    "dev:build": "bun build browser/*.tsx --outdir=dist --target=browser --splitting --watch",
    "start": "bun run build && bun main.ts",
    "migrate": "bun migrations/migrate.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bun-types": "^1.4.5"
  }
}
